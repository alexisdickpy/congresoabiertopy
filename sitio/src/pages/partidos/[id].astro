---
// Perfil temático de un partido (lib/perfilPartidos.js, alcance acordado en #93): una tabla compacta por
// cámara (#99) con una fila por tema, el reparto de los votos de sus legisladores en las categorías
// oficiales, el denominador y el enlace a la página del tema, que tiene la lista de votaciones. Las cifras
// son las mismas de los votos por tema (#37). Sin cifra única de apoyo y sin sumar cámaras.
import Base from "../../layouts/Base.astro";
import TablaTemasPartido from "../../components/TablaTemasPartido.astro";
import { NOMBRE_VOTOS_POR_TEMA } from "../../lib/calculados.js";
import { periodos } from "../../lib/datos.js";
import { valorDePartido } from "../../lib/coincidencia.js";
import { perfilesDePartidos } from "../../lib/perfilPartidos.js";
import * as rutas from "../../lib/rutas.js";
import { legible } from "../../lib/texto.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.partidos.perfil;
const txc = textos.general.comunes;

export function getStaticPaths() {
  const periodo = periodos().find((p) => p.vigente).id;
  return perfilesDePartidos(periodo).map((p: any) => ({ params: { id: p.id }, props: { periodo, partido: p } }));
}

const { periodo, partido } = Astro.props;
const numero = (n: number) => n.toLocaleString("es-PY");
const nombreCamara = new Map(partido.camaras.map((c: any) => [c.camara, c.nombre]));
const nombre = legible(partido.nombre) + (partido.nombreConocido && partido.nombreConocido !== partido.sigla ? ` (${partido.nombreConocido})` : "");
const conSigla = partido.sigla && partido.sigla !== partido.nombre ? `${partido.sigla} · ${nombre}` : nombre;
---

<Base titulo={fill(tx.titulo, { nombre: conSigla })} descripcion={fill(tx.descripcion, { nombre, periodo })}>
  <p class="chico" set:html={md(tx.volver, { url1: crudo(rutas.partidos()) })} />
  <h1 class={partido.clase}><span class="pip"></span> {partido.sigla && partido.sigla !== partido.nombre && <span>{partido.sigla} · </span>}{nombre}</h1>

  <dl class="datos-partido">
    <div>
      <dt>{tx.legisladoresEnEjercicio}</dt>
      <dd>{partido.camaras.map((c: any) => `${c.nombre} ${c.legisladores}`).join(" · ")}</dd>
    </div>
    <div>
      <dt>{tx.textoOficial}</dt>
      <dd>{partido.textos.map((t: any) => `${legible(t.texto)} (${nombreCamara.get(t.camara) ?? t.camara})`).join(" · ")}</dd>
    </div>
  </dl>

  <h2>{tx.votosPorTema}</h2>
  <div class="lectura">
    <p set:html={md(tx.paraCadaTema, { url1: crudo(rutas.votosPorTema()) })} />
    <p class="chico texto-suave">
      {tx.aviso} <a href={rutas.metodologia(rutas.anclasMetodologia.perfilPartidos)}>{txc.comoSeCalcula}</a>
    </p>
  </div>
  <ul class="leyenda chico" aria-hidden="true">
    {partido.leyenda.map((l: any) => <li><span class={`muestra ${l.clase}`}></span>{l.categoria}</li>)}
  </ul>

  <p class="chico texto-suave lectura">{tx.comoLeerLaTabla}</p>
  {partido.tablas.length === 0 && <p class="chico texto-suave">{tx.sinVotos}</p>}
  {partido.tablas.map((t: any) => <TablaTemasPartido tabla={t} titulo={fill(tx.tablaTitulo, { camara: t.nombre })} />)}

  <h2>{tx.masSobreEstePartido}</h2>
  <ul class="chico">
    <li><a href={rutas.legisladoresDePartido(partido.id)}>{tx.susLegisladores}</a></li>
    <li><a href={rutas.coincidencia(valorDePartido(partido.id))}>{tx.coincidenciaConOtros}</a></li>
    <li><a href={rutas.archivoCalculado(periodo, NOMBRE_VOTOS_POR_TEMA, "csv")} download>{txc.descargarLaTablaCsv}</a></li>
  </ul>
</Base>

<style>
  .datos-partido {
    display: grid;
    gap: var(--espacio-2);
    margin: 0 0 var(--espacio-4);
  }
  .datos-partido dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  .datos-partido dd {
    margin: 0;
  }
  .leyenda {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) var(--espacio-4);
  }
  .leyenda li {
    display: flex;
    align-items: center;
    gap: var(--espacio-1);
  }
  .muestra {
    display: inline-block;
    width: var(--espacio-4);
    height: var(--espacio-4);
    border-radius: var(--radio);
  }
</style>
