---
// Colabora (#133): una introducción breve, una tarjeta por cada forma de ayudar y el correo del proyecto con
// botón para copiarlo. Las que no van a GitHub llevan al formulario de contacto con el asunto ya puesto
// (#140). Textos en contenido/colabora.json.
import Base from "../layouts/Base.astro";
import CopiarCorreo from "../components/CopiarCorreo.astro";
import TarjetasAccion from "../components/TarjetasAccion.astro";
import * as rutas from "../lib/rutas.js";
import { crudo, md, textos } from "../lib/contenido.js";

const tx = textos.colabora;
const tarjetas = tx.formas.map((f) => {
  const externo = f.clave === "codigo";
  return { ...f, externo, url: externo ? rutas.codigoFuente() : rutas.formularioContacto({ asunto: f.asunto }) };
});
---

<Base titulo={tx.pagina.titulo} descripcion={tx.pagina.descripcion}>
  <h1>{tx.pagina.titulo}</h1>
  <p class="lectura" set:html={md(tx.introduccion, { urlContacto: crudo(rutas.contacto()), urlCodigo: crudo(rutas.codigoFuente()) })} />
  <TarjetasAccion tarjetas={tarjetas} etiqueta={tx.pagina.titulo} />
  <div class="lectura">
    <p set:html={md(tx.correoDirecto)} />
    <CopiarCorreo />
  </div>
</Base>
