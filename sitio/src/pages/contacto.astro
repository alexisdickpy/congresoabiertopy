---
// Contacto (#133, #140): un formulario que llega por correo al proyecto, sin guardarse en el sitio, y el
// correo del proyecto con un botón para copiarlo. "Reportar un error" del pie trae a este formulario con la
// página ya escrita. En el menú principal y en el pie. Textos en contenido/contacto.json.
import Base from "../layouts/Base.astro";
import CopiarCorreo from "../components/CopiarCorreo.astro";
import FormularioContacto from "../components/FormularioContacto.astro";
import * as rutas from "../lib/rutas.js";
import { crudo, md, textos } from "../lib/contenido.js";

const tx = textos.contacto;
---

<Base titulo={tx.pagina.titulo} descripcion={tx.pagina.descripcion}>
  <div class="lectura">
    <h1>{tx.pagina.titulo}</h1>
    <p set:html={md(tx.texto)} />
    <p set:html={md(tx.consejo)} />
    <FormularioContacto />
    <p set:html={md(tx.correoDirecto)} />
    <CopiarCorreo />
    <p class="nota" set:html={md(tx.aclaracion, { urlColabora: crudo(rutas.colabora()) })} />
  </div>
</Base>

<style>
  .nota {
    color: var(--color-texto-suave);
  }
</style>
