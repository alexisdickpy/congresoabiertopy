---
// Búsqueda estática con Pagefind: el índice se genera al final de la compilación
// (npm run build, scripts/indice-busqueda.js) y el navegador descarga solo los fragmentos que necesita.
// Incluye leyes, proyectos de ley del período con su estado oficial (#104) y legisladores, con un
// filtro por tipo.
import Base from "../layouts/Base.astro";
import * as rutas from "../lib/rutas.js";
import { TIPOS_BUSQUEDA } from "../lib/busqueda.js";
import { textos, md, crudo } from "../lib/contenido.js";
const tx = textos.buscar.pagina;
const ti = textos.interaccion.buscar;
const filtros = [
  { valor: TIPOS_BUSQUEDA.todos, texto: ti.todos },
  { valor: TIPOS_BUSQUEDA.ley, texto: ti.leyes },
  { valor: TIPOS_BUSQUEDA.proyecto, texto: ti.proyectos },
];
---

<Base titulo={tx.buscarLeyes} descripcion={tx.buscarLeyesDelCongresoNacional}>
  <h1>{tx.buscarLeyes}</h1>
  <form class="buscador" id="buscador" role="search" method="get">
    <label for="busqueda">{tx.numeroDeLeyOPalabras}</label>
    <div class="fila">
      <input type="search" id="busqueda" name={rutas.parametroBusqueda} autocomplete="off" />
      <button type="submit">{tx.buscar}</button>
    </div>
    <fieldset class="tipos">
      <legend>{tx.mostrar}</legend>
      {
        filtros.map((f, n) => (
          <label>
            <input type="radio" name="tipo" value={f.valor} checked={n === 0} /> {f.texto}
          </label>
        ))
      }
    </fieldset>
  </form>
  <p class="chico texto-suave lectura">{tx.queIncluye}</p>
  <p id="busqueda-estado" class="chico texto-suave" aria-live="polite"></p>
  <ol id="busqueda-resultados" class="resultados"></ol>
  <button type="button" id="busqueda-mas" hidden>{tx.verMasResultados}</button>
  <noscript>
    <p set:html={md(tx.laBusquedaNecesitaJavascriptTambien, { url1: crudo(rutas.leyes()) })} />
  </noscript>
</Base>

<script>
  import { parametroBusqueda } from "../lib/rutas.js";
  import { TIPOS_BUSQUEDA } from "../lib/busqueda.js";
  import interaccion from "../contenido/interaccion.json";
  import { fill } from "../lib/rellenar.js";
  const ti = interaccion.buscar;

  const POR_PAGINA = 20;
  const form = document.getElementById("buscador") as HTMLFormElement;
  const campo = document.getElementById("busqueda") as HTMLInputElement;
  const estado = document.getElementById("busqueda-estado")!;
  const lista = document.getElementById("busqueda-resultados")!;
  const mas = document.getElementById("busqueda-mas") as HTMLButtonElement;
  const tipos = [...form.querySelectorAll<HTMLInputElement>('input[name="tipo"]')];
  const tipoElegido = () => {
    const valor = tipos.find((t) => t.checked)?.value;
    return valor && valor !== TIPOS_BUSQUEDA.todos ? valor : "";
  };
  const ETIQUETAS: Record<string, string> = {
    [TIPOS_BUSQUEDA.ley]: ti.leySancionada,
    [TIPOS_BUSQUEDA.proyecto]: ti.proyectoDeLey,
    [TIPOS_BUSQUEDA.legislador]: ti.legislador,
  };
  let pagefind: any;
  let resultados: any[] = [];
  let mostrados = 0;
  let turno = 0;

  async function cargar() {
    if (!pagefind) {
      const ruta = "/pagefind/pagefind.js";
      pagefind = await import(/* @vite-ignore */ ruta);
      await pagefind.init();
    }
    return pagefind;
  }

  async function mostrarMas() {
    const miTurno = turno;
    const tanda = resultados.slice(mostrados, mostrados + POR_PAGINA);
    mostrados += tanda.length;
    const datos = await Promise.all(tanda.map((r) => r.data()));
    if (miTurno !== turno) return;
    for (const d of datos) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = d.url;
      a.textContent = d.meta.title;
      const tipo = d.filters?.tipo?.[0] ?? "";
      li.dataset.tipo = tipo;
      const datos = document.createElement("p");
      datos.className = "tipo-resultado";
      const partes = [ETIQUETAS[tipo], d.meta.expediente && fill(ti.expediente, { expediente: d.meta.expediente })].filter(Boolean);
      datos.textContent = partes.join(" · ");
      if (d.meta.estado) {
        const estadoOficial = document.createElement("strong");
        estadoOficial.textContent = fill(ti.estadoOficial, { estado: d.meta.estado });
        datos.append(partes.length ? " · " : "", estadoOficial);
      }
      const p = document.createElement("p");
      p.className = "extracto";
      p.innerHTML = d.excerpt; // Pagefind escapa el texto y solo agrega <mark>.
      li.append(a, datos, p);
      lista.append(li);
    }
    mas.hidden = mostrados >= resultados.length;
  }

  async function buscar(texto: string) {
    const miTurno = ++turno;
    lista.replaceChildren();
    mas.hidden = true;
    resultados = [];
    mostrados = 0;
    if (!texto.trim()) {
      estado.textContent = "";
      return;
    }
    estado.textContent = ti.buscando;
    try {
      const pf = await cargar();
      const tipo = tipoElegido();
      const respuesta = await pf.search(texto, tipo ? { filters: { tipo } } : {});
      if (miTurno !== turno) return;
      resultados = respuesta.results;
      estado.textContent =
        resultados.length === 0
          ? ti.sinResultados
          : resultados.length === 1
            ? ti.unResultado
            : fill(ti.variosResultados, { cantidad: resultados.length });
      await mostrarMas();
    } catch {
      estado.textContent = ti.noDisponible;
    }
  }

  function actualizarDireccion(texto: string) {
    const p = new URLSearchParams();
    if (texto) p.set(parametroBusqueda, texto);
    if (tipoElegido()) p.set("tipo", tipoElegido());
    const consulta = p.toString();
    history.replaceState(null, "", consulta ? `?${consulta}` : location.pathname);
  }

  function buscarAhora() {
    clearTimeout(espera);
    actualizarDireccion(campo.value.trim());
    buscar(campo.value);
  }

  let espera: ReturnType<typeof setTimeout>;
  campo.addEventListener("input", () => {
    clearTimeout(espera);
    espera = setTimeout(buscarAhora, 250);
  });
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    buscarAhora();
  });
  mas.addEventListener("click", mostrarMas);
  for (const t of tipos) t.addEventListener("change", buscarAhora);

  const consulta = new URLSearchParams(location.search);
  const tipoInicial = tipos.find((t) => t.value === consulta.get("tipo"));
  if (tipoInicial) tipoInicial.checked = true;
  const inicial = consulta.get(parametroBusqueda) ?? "";
  campo.value = inicial;
  if (inicial) buscar(inicial);
</script>

<style>
  .buscador {
    max-width: var(--ancho-lectura);
    margin-bottom: var(--espacio-3);
  }
  .fila {
    display: flex;
    gap: var(--espacio-2);
  }
  .resultados {
    max-width: var(--ancho-lectura);
    padding-left: var(--espacio-5);
  }
  .resultados :global(li) {
    margin-bottom: var(--espacio-4);
  }
  .tipos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) var(--espacio-4);
    margin: var(--espacio-3) 0 0;
    padding: 0;
    border: 0;
  }
  .tipos legend {
    padding: 0;
    margin-bottom: var(--espacio-1);
    font-size: var(--tamano-chico);
    font-weight: var(--peso-fuerte);
  }
  .tipos label {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-1);
    margin: 0;
    font-size: var(--tamano-base);
    font-weight: var(--peso-normal);
  }
  .resultados :global(.tipo-resultado) {
    margin: var(--espacio-1) 0 0;
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  .resultados :global(.extracto) {
    margin: var(--espacio-1) 0 0;
    font-size: var(--tamano-chico);
  }
</style>
