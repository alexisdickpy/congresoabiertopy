---
// Cuadro de leyes por tema (lib/resumenTemas.js, #36): un cuadro por tema con el fondo y el borde del
// color del tema (#92), la cantidad de leyes y la de proyectos votados sin ley. Cada cuadro lleva al
// catálogo filtrado por ese tema. Se usa en el catálogo de leyes, con los proyectos por estado oficial,
// y en la portada (`portada`), con solo el total de proyectos votados sin ley y sin "Pendiente de
// clasificación".
import * as rutas from "../lib/rutas.js";
import { resumenPorTema } from "../lib/resumenTemas.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.portada.cuadroTemas;

interface Props {
  periodo: string;
  nivel?: 2 | 3;
  portada?: boolean;
}
const { periodo, nivel = 2, portada = false } = Astro.props;
const Titulo = `h${nivel}`;
const Tema = `h${nivel + 1}`;
const cuadros = resumenPorTema(periodo, { conPendiente: !portada });
const numero = (n: number) => n.toLocaleString("es-PY");
const plural = (n: number, singular: string, varios: string) => `${numero(n)} ${n === 1 ? singular : varios}`;
const sinLey = (c: any) =>
  [
    c.archivados && plural(c.archivados, "archivado", "archivados"),
    c.enTramite && fill(tx.enTramite, { enTramite: numero(c.enTramite) }),
    c.otros && plural(c.otros, tx.enOtroEstado, tx.enOtroEstado),
  ].filter(Boolean);
---

<section class="cuadro-temas" aria-labelledby="titulo-cuadro-temas">
  <Titulo id="titulo-cuadro-temas">{tx.leyesPorTema}</Titulo>
  <p class="chico texto-suave" set:html={md(tx.clasificacionDelObservatorioNoDel, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.temas)) })} />
  <ul class="tarjetas-tema">
    {
      cuadros.map((c) => (
        <li class="tarjeta-tema" data-tema={c.id}>
          <Tema class="nombre"><a href={c.url}>{c.nombre}</a></Tema>
          <p class="cifra"><strong>{plural(c.leyes, tx.leySancionada, tx.leyesSancionadas)}</strong></p>
          {sinLey(c).length > 0 &&
            (portada ? (
              <p class="chico texto-suave">{fill(tx.masProyectosVotadosSinLey, { proyectos: plural(c.archivados + c.enTramite + c.otros, tx.proyectoVotado, tx.proyectosVotados) })}</p>
            ) : (
              <p class="chico texto-suave">{plural(c.archivados + c.enTramite + c.otros, tx.proyectoVotado, tx.proyectosVotados)} {tx.sinLey}{sinLey(c).join(" · ")})</p>
            ))}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cuadro-temas {
    margin: var(--espacio-5) 0;
  }
  .tarjetas-tema {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--espacio-3);
  }
  /* Cuadro con el color de su tema, como los de /votos-por-tema/: fondo suave y borde superior (#92). */
  .tarjeta-tema {
    padding: var(--espacio-3);
    border: var(--borde-ancho) solid var(--color-borde);
    border-top: var(--foco-ancho) solid var(--color-tema, var(--color-borde));
    border-radius: var(--radio);
    background: color-mix(in srgb, var(--color-tema, var(--color-borde)) var(--mezcla-fondo-tema), var(--color-fondo));
  }
  .nombre {
    margin: 0 0 var(--espacio-1);
    font-size: var(--tamano-base);
  }
  .nombre a,
  .nombre a:visited {
    color: var(--color-texto);
  }
  p {
    margin: 0;
  }
</style>
