---
// Apartado de la portada con cada vista de análisis (lib/navegacion.js) que no lleva `portada: false`.
// Con parte="tarjetas", un bloque a lo ancho por vista, primero los más "rebeldes" y después la
// coincidencia de votos entre partidos (#92), cada uno con las dos cámaras lado a lado (senadores a la
// izquierda, diputados a la derecha) y alineadas por fila. La portada muestra solo partidos; las
// bancadas están en la página de coincidencia. Con la clave de una vista de
// `portadaAlFinal` (hoy, "temas" y "votaciones"), solo esa vista a lo ancho, donde la ponga la portada:
// su enlace, una línea sobre qué muestra y una vista previa con datos por cámara (lib/portada.js,
// alcance acordado en #51). Solo la de rankings lleva nombres de personas, los primeros de más
// "rebeldes" (#54, #57). Una vista sin vista previa propia muestra solo el enlace y la línea. En
// la coincidencia se elige el partido del gráfico; al abrir, el de más legisladores en ejercicio.
import BarrasCoincidencia from "./BarrasCoincidencia.astro";
import ListaVotaciones from "./ListaVotaciones.astro";
import ListaRanking from "./ListaRanking.astro";
import EtiquetasTema from "./EtiquetasTema.astro";
import { vistasDeAnalisis } from "../lib/navegacion.js";
import { vistaPrevia } from "../lib/portada.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.portada.analisis;
const txc = textos.general.comunes;

interface Props {
  periodo: string;
  parte: string;
}
const { periodo, parte } = Astro.props;
const previa = vistaPrevia(periodo);
const numero = (n: number) => n.toLocaleString("es-PY");
const plural = (n: number, singular: string, varios: string) => `${numero(n)} ${n === 1 ? singular : varios}`;
/** Orden de los bloques de arriba: primero los más "rebeldes", después la coincidencia (#92). */
const ORDEN = ["rankings", "coincidencia"];
/** Filas de la lista de rebeldes, para alinear los puestos de las dos cámaras. */
const filasRanking = Math.max(0, ...previa.votosDistintos.map((c) => c.filas.length));
---

{parte === "tarjetas" && (
<div class="analisis">
  {
    vistasDeAnalisis()
      .filter((v) => v.portada !== false && !v.portadaAlFinal)
      .sort((a, b) => ORDEN.indexOf(a.clave) - ORDEN.indexOf(b.clave))
      .map((v) => (
      <section class="bloque" data-analisis={v.clave} aria-labelledby={`titulo-${v.clave}`}>
        <h2 id={`titulo-${v.clave}`}>
          <a href={v.url}>{v.clave === "coincidencia" ? tx.quePartidosVotanIgual : v.titulo}</a>
        </h2>
        <p class="chico">{v.clave === "coincidencia" ? tx.descripcionCoincidencia : v.descripcion}</p>
        {v.clave === "coincidencia" && (
          <form class="selector-partido chico" id="selector-partido-portada" hidden>
            <label for="partido-portada">{tx.compararCon}</label>
            <select id="partido-portada">
              {previa.partidos.map((p) => <option value={p.id}>{p.nombre}</option>)}
            </select>
          </form>
        )}
        {v.clave === "coincidencia" && (
          <div class="dos-camaras">
            {previa.coincidencia.map((c) => (
              <div class="camara camara-coincidencia">
                <h3 class="chico">{c.camara}</h3>
                <p class="chico texto-suave">{plural(c.votaciones, txc.votacionNominal, txc.votacionesNominales)} {tx.sobreProyectosDeLey}</p>
                <div class="graficos">
                  {c.graficos.map((g, i) => (
                    <div data-grafico-partido={g.id} hidden={i > 0}>
                      {g.barras.length > 0 ? (
                        <BarrasCoincidencia referencia={g.referencia} barras={g.barras} />
                      ) : (
                        <p class="chico texto-suave">
                          {g.referencia
                            ? fill(tx.noTieneVotacionesEnComun, { referencia: g.referencia })
                            : fill(tx.noTieneLegisladoresEnEsta, { nombre: previa.partidos[i].nombre })}
                        </p>
                      )}
                    </div>
                  ))}
                </div>
                {c.mayor ? (
                  <p class="chico">
                    {fill(tx.entreTodosLosParesMas, { valor: c.mayor.a, valor2: c.mayor.b, porcentajeTexto: c.mayor.porcentajeTexto, valor3: c.menor.a, valor4: c.menor.b, porcentajeTexto2: c.menor.porcentajeTexto })}
                  </p>
                ) : <span />}
              </div>
            ))}
          </div>
        )}
        {v.clave === "rankings" && (
          <div class="dos-camaras" style={`--filas: ${filasRanking}; --filas-camara: ${filasRanking + 1}`}>
            {previa.votosDistintos.map((c) => (
              <div class="camara camara-ranking">
                <h3 class="chico">{c.camara}</h3>
                <ListaRanking filas={c.filas} cifra="mayoriaPartido" />
              </div>
            ))}
          </div>
        )}
        <p class="chico ver-mas" set:html={md(tx.ver, { url1: crudo(v.url), titulo: v.clave === "coincidencia" ? tx.laCoincidenciaCompleta : v.titulo.toLowerCase() })} />
      </section>
    ))
  }
</div>
)}
  {
    vistasDeAnalisis()
      .filter((v) => v.portada !== false && v.portadaAlFinal && v.clave === parte)
      .map((v) => (
        <article class="tarjeta al-final" data-analisis={v.clave}>
          <h2>
            <a href={v.url}>{v.titulo}</a>
          </h2>
          <p class="chico">{v.descripcion}</p>
          {v.clave === "temas" && <div class="temas-portada"><EtiquetasTema clasificacion={{ temas: previa.temas, pendiente: false }} enlaces /></div>}
          {v.clave === "votaciones" && <ListaVotaciones votaciones={previa.votaciones} />}
          <p class="chico">
            <a href={v.url}>{v.clave === "votaciones" ? tx.verTodasLasVotacionesY : fill(tx.ver2, { titulo: v.titulo.toLowerCase() })}</a>
          </p>
        </article>
      ))
  }

<script>
  // Sin JavaScript el selector queda oculto y se ve el gráfico del primer partido (el de más
  // legisladores). Con JavaScript, muestra en cada cámara el gráfico del partido elegido.
  const form = document.getElementById("selector-partido-portada") as HTMLFormElement | null;
  if (form) {
    const select = form.querySelector("select")!;
    const graficos = [...document.querySelectorAll<HTMLElement>("[data-grafico-partido]")];
    const aplicar = () => {
      for (const g of graficos) g.hidden = g.dataset.graficoPartido !== select.value;
    };
    form.hidden = false;
    aplicar();
    select.addEventListener("change", aplicar);
    form.addEventListener("submit", (e) => e.preventDefault());
  }
</script>

<style>
  .selector-partido {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2) var(--espacio-3);
    align-items: center;
  }
  .selector-partido[hidden] {
    display: none;
  }
  .selector-partido select {
    max-width: 100%;
  }
  .bloque {
    margin-top: var(--espacio-6);
    border-top: var(--borde-ancho) solid var(--color-borde-fuerte);
    padding-top: var(--espacio-3);
  }
  .bloque h2 {
    margin-top: 0;
  }
  /* Las dos cámaras lado a lado; en pantallas angostas, una debajo de la otra. */
  .dos-camaras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0 var(--espacio-6);
  }
  /* Filas compartidas: cada parte (y cada puesto del ranking) arranca a la misma altura en las dos columnas. */
  .camara-coincidencia {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    align-content: start;
  }
  .camara-ranking {
    display: grid;
    grid-row: span var(--filas-camara);
    grid-template-rows: subgrid;
  }
  .camara-ranking :global(.lista-ranking) {
    display: grid;
    grid-row: span var(--filas);
    grid-template-rows: subgrid;
  }
  .tarjeta {
    border-top: var(--borde-ancho) solid var(--color-borde-fuerte);
    padding-top: var(--espacio-3);
    min-width: 0;
  }
  .camara {
    margin-top: var(--espacio-4);
  }
  .al-final {
    margin-top: var(--espacio-6);
  }
  .tarjeta h2 {
    margin-top: 0;
  }
  /* Etiquetas de los temas como cuadritos con el color de su tema (#92), como los de "Leyes por tema". */
  .temas-portada {
    margin: var(--espacio-3) 0;
  }
  .temas-portada :global(.tema) {
    padding: var(--espacio-1) var(--espacio-3);
    border: var(--borde-ancho) solid var(--color-tema);
    border-left-width: var(--foco-ancho);
    border-radius: var(--radio);
    background: color-mix(in srgb, var(--color-tema) var(--mezcla-fondo-tema), var(--color-fondo));
    text-decoration: none;
  }
  .temas-portada :global(.tema:hover) {
    background: color-mix(in srgb, var(--color-tema) calc(var(--mezcla-fondo-tema) * 2), var(--color-fondo));
  }
  .camara h3 {
    margin: 0 0 var(--espacio-2);
  }
  .camara p {
    margin: var(--espacio-1) 0;
  }
</style>
