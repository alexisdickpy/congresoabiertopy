---
// Cuadro de coincidencia de todos los pares de partidos de una cámara: filas y columnas con los
// mismos partidos, y en cada celda el porcentaje con su numerador y su denominador. El sombreado es
// de un solo tono (más intenso = más coincidencia), sin colores que califiquen, en cinco niveles
// repartidos entre el menor y el mayor porcentaje del cuadro (lib/coincidencia.js, #93), con su leyenda;
// los colores están en tokens.css. Filas y columnas van de más a menos
// legisladores en ejercicio en esa cámara. Con pocas votaciones en común, solo las
// cantidades y sin sombreado.
import { escalaDelCuadro, NIVELES_CUADRO, nivelDe } from "../lib/coincidencia.js";
import { clasePartido } from "../lib/partidos.js";
import { legible } from "../lib/texto.js";
import { periodos } from "../lib/datos.js";
import { perfilesDePartidos } from "../lib/perfilPartidos.js";
import * as rutas from "../lib/rutas.js";
import { textos, fill } from "../lib/contenido.js";
const tx = textos.coincidencia.cuadro;

interface Props {
  titulo: string;
  filas: { id: string; nombre: string; legisladores: number; celdas: any[] }[];
}
const { titulo, filas } = Astro.props;
const escala = escalaDelCuadro(filas);
const celdas = filas.flatMap((f) => f.celdas).filter((c) => c?.suficiente);
const textoDe = (p: number) => celdas.find((c) => c.porcentaje === p)?.porcentajeTexto;
const niveles = Array.from({ length: NIVELES_CUADRO }, (_, n) => n + 1);
// Cada partido enlaza a su perfil (#93), si lo tiene en el período vigente.
const conPerfil = new Set(perfilesDePartidos(periodos().find((p) => p.vigente).id).map((p) => p.id));
---

<div class="cuadro-coincidencia-desplazable">
  <table class="cuadro-coincidencia">
    <caption class="solo-lectores">{titulo}</caption>
    <thead>
      <tr>
        <td></td>
        {filas.map((f) => <th scope="col"><span class="vertical"><span class={`pip ${clasePartido(f.nombre)}`}></span> {legible(f.nombre)}</span></th>)}
      </tr>
    </thead>
    <tbody>
      {filas.map((f) => <tr data-cuadro-fila={f.id}><th scope="row"><span class={`pip ${clasePartido(f.nombre)}`}></span> {conPerfil.has(f.id) ? <a href={rutas.partidos(f.id)}>{legible(f.nombre)}</a> : legible(f.nombre)}<span class="bancas">{f.legisladores} {f.legisladores === 1 ? "legislador" : "legisladores"} {tx.enEjercicio}</span></th>{f.celdas.map((c) => !c ? <td class="diagonal"><span aria-hidden="true">—</span><span class="solo-lectores">{tx.mismoPartido}</span></td> : c.suficiente ? <td class={`nivel-${nivelDe(c, escala)}`}><span class="porcentaje">{c.porcentajeTexto}</span> <span class="fraccion">{c.fraccion}</span></td> : <td class="sin-porcentaje"><span class="fraccion">{c.fraccion}</span> <span class="fraccion">{tx.sin}</span></td>)}</tr>)}
    </tbody>
  </table>
</div>
{
  escala && (
    <div class="escala-cuadro chico">
      <span>{tx.menosCoincidencia}</span>
      <span class="tonos" aria-hidden="true">{niveles.map((n) => <span class={`tono nivel-${n}`}></span>)}</span>
      <span>{tx.masCoincidencia}</span>
      <span class="texto-suave">{fill(tx.escala, { minimo: textoDe(escala.minimo), maximo: textoDe(escala.maximo) })}</span>
    </div>
  )
}

<style>
  .cuadro-coincidencia-desplazable {
    position: relative; /* contiene los textos solo para lectores de pantalla de sus celdas */
    overflow-x: auto;
    margin-bottom: var(--espacio-5);
  }
  .cuadro-coincidencia {
    border-collapse: collapse;
    font-size: var(--tamano-chico);
  }
  .cuadro-coincidencia th,
  .cuadro-coincidencia td {
    padding: var(--espacio-2);
    border: var(--borde-ancho) solid var(--color-borde);
  }
  .cuadro-coincidencia thead th,
  .cuadro-coincidencia thead td {
    border-top: none;
    vertical-align: bottom;
  }
  .cuadro-coincidencia thead td {
    border-left: none;
  }
  .cuadro-coincidencia tbody th {
    text-align: left;
    font-weight: var(--peso-normal);
    min-width: var(--ancho-nombre-barra);
  }
  .vertical {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-weight: var(--peso-normal);
  }
  .cuadro-coincidencia td {
    width: var(--ancho-celda-cuadro);
    min-width: var(--ancho-celda-cuadro);
    text-align: center;
  }
  .nivel-1 { background: var(--color-cuadro-1); }
  .nivel-2 { background: var(--color-cuadro-2); }
  .nivel-3 { background: var(--color-cuadro-3); }
  .nivel-4 { background: var(--color-cuadro-4); color: var(--color-cifra-cuadro-fuerte); }
  .nivel-5 { background: var(--color-cuadro-5); color: var(--color-cifra-cuadro-fuerte); }
  .escala-cuadro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espacio-1) var(--espacio-2);
    margin: var(--espacio-2) 0 var(--espacio-4);
  }
  .tonos {
    display: inline-flex;
  }
  .tono {
    width: var(--espacio-5);
    height: var(--espacio-3);
    border: var(--borde-ancho) solid var(--color-borde);
  }
  .cuadro-coincidencia td.diagonal {
    background: var(--color-superficie);
  }
  .porcentaje {
    display: block;
    font-weight: var(--peso-fuerte);
  }
  .fraccion {
    display: block;
    white-space: nowrap;
  }
  .bancas {
    display: block;
    color: var(--color-texto-suave);
  }
  .sin-porcentaje {
    color: var(--color-texto-suave);
  }
</style>
